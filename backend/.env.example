# Copiar a .env (nunca subir .env real a GitHub) y llenar con los valores reales.
# En Hostinger, estas variables se configuran en el panel de la app Node.js
# (Variables de entorno), no en este archivo.

PORT=3000

# Base de datos MySQL (pedidos + numeración interna). En Hostinger se crea y
# se llena sola con `hosting_databases_setup-website`, que escribe estas
# mismas 5 variables + DATABASE_URL — no hace falta tocarlas a mano ahí.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Correo del taller. Puede ser el buzón del propio dominio (se crea en
# hPanel > Correo, puerto 465/secure) o un Gmail existente con una
# "contraseña de aplicación" (smtp.gmail.com, puerto 587/STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=buenosprints.taller@gmail.com
SMTP_PASS=
TALLER_EMAIL=buenosprints.taller@gmail.com

# Google Sheets como CRM (opcional — si se deja vacío, simplemente no se usa).
# Debe ser una copia en Google Sheets de "Buenos Prints - CRM de Pedidos.xlsx"
# con sus pestañas "Pedidos" y "Detalle de productos" tal cual (no renombrar).
# GOOGLE_SHEET_ID es el ID de la hoja (está en la URL de Google Sheets).
# GOOGLE_SERVICE_ACCOUNT_JSON es el contenido completo del JSON de la cuenta
# de servicio (con acceso de Editor sobre esa hoja), en una sola línea.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# URL pública del backend, para armar el link al PDF que se guarda en la fila
# de Google Sheets. Cambiar solo si el dominio de la API cambia.
BASE_URL=https://api.buenosprints.com
